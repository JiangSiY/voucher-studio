{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Voucher Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 640,
        "center": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["mica", "acrylic"],
          "state": "active"
        }
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$DATA/VoucherStudio/data/attachments/**/*"]
      }
    }
  },
  "bundle": {
    "resources": {
      "../assets/ocr-models/": "ocr-models/",
      "vendor/opencv_world4100.dll": "opencv_world4100.dll"
    }
  }
}
