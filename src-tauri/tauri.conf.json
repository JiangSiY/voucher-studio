{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voucher Studio",
  "version": "0.11.0",
  "identifier": "com.voucherstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Voucher Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 640,
        "center": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["mica", "acrylic"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../assets/ocr-models/": "ocr-models/",
      "vendor/opencv_world4100.dll": "opencv_world4100.dll"
    }
  }
}
