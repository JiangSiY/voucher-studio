{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voucher Spike M",
  "version": "0.1.0",
  "identifier": "com.voucherstudio.spike-window",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Spike M · macOS 窗口材质验证",
        "width": 980,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 18 },
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["../../src-tauri/icons/icon.png"]
  }
}
